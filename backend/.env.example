# Port the service listens on (Render/Railway inject this automatically)
PORT=3001

# Absolute public origin, e.g. https://hhgoa-frame.onrender.com
# Set this in production so OG image URLs are always absolute and correct.
PUBLIC_URL=

# Where generated passes are written. Point at a mounted volume in production
# so share links survive restarts.
DATA_DIR=./data

# How long share links stay alive
SHARE_TTL_DAYS=30

# Max accepted upload
MAX_UPLOAD_BYTES=8388608
